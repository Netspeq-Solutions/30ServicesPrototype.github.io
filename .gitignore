# ========================================================
# Git Ignore - Sikkim Government Services Prototype Framework
# ========================================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Temporary Scratch & Test Artifacts
scratch/
*.tmp
*.temp
*.log

# Node & Build Artifacts (Prohibited by Framework, guardrail against accidental commits)
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
dist/
build/
.cache/
